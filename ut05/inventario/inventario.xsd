<?xml version="1.0" encoding="UTF-8"?>
<!-- inventario.xsd · Esquema del inventario de equipos de red del aula -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Identificador del equipo: EQ- y dos dígitos -->
  <xs:simpleType name="tipoId">
    <xs:restriction base="xs:string">
      <xs:pattern value="EQ-[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- IPv4: cuatro números de 0 a 255 separados por puntos -->
  <xs:simpleType name="tipoIPv4">
    <xs:restriction base="xs:string">
      <xs:pattern value="((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- MAC: seis pares hexadecimales separados por dos puntos -->
  <xs:simpleType name="tipoMAC">
    <xs:restriction base="xs:string">
      <xs:pattern value="([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoEquipo">
    <xs:restriction base="xs:string">
      <xs:enumeration value="router"/>
      <xs:enumeration value="switch"/>
      <xs:enumeration value="punto-acceso"/>
      <xs:enumeration value="servidor"/>
      <xs:enumeration value="nas"/>
      <xs:enumeration value="cortafuegos"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Número de puertos de 1 a 52 -->
  <xs:simpleType name="tipoPuertos">
    <xs:restriction base="xs:positiveInteger">
      <xs:maxInclusive value="52"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="tipoRed">
    <xs:sequence>
      <xs:element name="ip" type="tipoIPv4"/>
      <xs:element name="mac" type="tipoMAC"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tipoEquipoRed">
    <xs:sequence>
      <xs:element name="marca" type="xs:string"/>
      <xs:element name="modelo" type="xs:string"/>
      <xs:element name="red" type="tipoRed"/>
      <xs:element name="ubicacion" type="xs:string"/>
      <xs:element name="fechaCompra" type="xs:date"/>
      <!-- Un equipo lleva el número de puertos o el sistema operativo, nunca los dos -->
      <xs:choice minOccurs="0">
        <xs:element name="puertos" type="tipoPuertos"/>
        <xs:element name="sistema" type="xs:string"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="id" type="tipoId" use="required"/>
    <xs:attribute name="tipo" type="tipoEquipo" use="required"/>
  </xs:complexType>

  <xs:element name="inventario">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="equipo" type="tipoEquipoRed" minOccurs="5" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="centro" type="xs:string" use="required"/>
      <xs:attribute name="aula" type="xs:string" use="required"/>
      <xs:attribute name="revisado" type="xs:date" use="required"/>
    </xs:complexType>

    <!-- No puede haber dos equipos con el mismo id, ni con la misma IP o MAC -->
    <xs:unique name="idUnico">
      <xs:selector xpath="equipo"/>
      <xs:field xpath="@id"/>
    </xs:unique>
    <xs:unique name="ipUnica">
      <xs:selector xpath="equipo/red"/>
      <xs:field xpath="ip"/>
    </xs:unique>
    <xs:unique name="macUnica">
      <xs:selector xpath="equipo/red"/>
      <xs:field xpath="mac"/>
    </xs:unique>
  </xs:element>

</xs:schema>
